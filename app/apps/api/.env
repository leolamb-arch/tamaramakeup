PORT=3001
CORS_ORIGIN=

# ── Google Calendar (OAuth) ──────────────────────────────────
# Crea unas credenciales OAuth en Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) tipo "App web",
# añade como URI de redirección autorizada:
#   https://TU-DOMINIO/hcgi/api/google/callback
# y pega aquí el ID y el secreto del cliente. GOOGLE_REDIRECT_URI
# puede quedar vacío (se deriva del host público) o fijarse explícitamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
